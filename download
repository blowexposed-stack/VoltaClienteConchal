<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>VoltaCliente Conchal — Dashboard</title>

  <!-- PWA -->
  <link rel="manifest" href="/static/manifest.json"/>
  <meta name="theme-color" content="#10b981"/>
  <meta name="mobile-web-app-capable" content="yes"/>
  <meta name="apple-mobile-web-app-capable" content="yes"/>
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
  <meta name="apple-mobile-web-app-title" content="VoltaCliente"/>
  <link rel="apple-touch-icon" href="/static/icon-192.png"/>

  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet"/>
  <style>
    * { font-family: 'Inter', sans-serif; }
    h1,h2,h3,.brand { font-family: 'Syne', sans-serif; }
    body { background: #0f172a; color: #e2e8f0; }
    .card { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.07); }
    .card-highlight { background: linear-gradient(135deg, rgba(16,185,129,0.12), rgba(5,150,105,0.06)); border: 1px solid rgba(16,185,129,0.2); }
    .input-field { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #f1f5f9; transition: all 0.2s; }
    .input-field:focus { outline:none; border-color:#10b981; background:rgba(16,185,129,0.08); box-shadow:0 0 0 3px rgba(16,185,129,0.12); }
    .input-field::placeholder { color:rgba(255,255,255,0.25); }
    select.input-field option { background:#1e293b; color:#f1f5f9; }
    .btn-primary { background:linear-gradient(135deg,#10b981,#059669); transition:all 0.2s; }
    .btn-primary:hover { transform:translateY(-1px); box-shadow:0 8px 24px rgba(16,185,129,0.3); }
    .btn-wpp { background:linear-gradient(135deg,#25d366,#128c7e); transition:all 0.2s; }
    .btn-wpp:hover { transform:translateY(-1px); box-shadow:0 8px 24px rgba(37,211,102,0.3); }
    .badge-pendente { background:rgba(251,191,36,0.12); color:#fbbf24; border:1px solid rgba(251,191,36,0.25); }
    .badge-enviado  { background:rgba(16,185,129,0.12); color:#10b981; border:1px solid rgba(16,185,129,0.25); }
    .badge-atrasado { background:rgba(239,68,68,0.12); color:#ef4444; border:1px solid rgba(239,68,68,0.25); }
    .flash-sucesso { background:rgba(16,185,129,0.1); border:1px solid rgba(16,185,129,0.3); color:#34d399; }
    .flash-erro    { background:rgba(239,68,68,0.1);  border:1px solid rgba(239,68,68,0.3);  color:#f87171; }
    .nav-link { color:rgba(255,255,255,0.5); transition:all 0.2s; }
    .nav-link:hover,.nav-link.active { color:#10b981; background:rgba(16,185,129,0.08); }
    .stat-num { font-family:'Syne',sans-serif; font-weight:800; }
    .table-row { border-bottom:1px solid rgba(255,255,255,0.04); transition:background 0.15s; }
    .table-row:hover { background:rgba(255,255,255,0.03); }
    .wpp-link-box { background:rgba(37,211,102,0.06); border:1px solid rgba(37,211,102,0.2); }
    .tab-btn { border-bottom: 2px solid transparent; color:rgba(255,255,255,0.4); transition:all 0.2s; padding-bottom:8px; }
    .tab-btn.active { border-color:#10b981; color:#10b981; }
    ::-webkit-scrollbar { width:4px; }
    ::-webkit-scrollbar-thumb { background:rgba(255,255,255,0.1); border-radius:99px; }
  </style>
</head>
<body class="min-h-screen">

{% if is_demo %}
<div class="fixed bottom-4 right-4 z-40 rounded-xl border border-emerald-500/30 bg-slate-950/95 px-4 py-3 shadow-xl">
  <p class="text-slate-400 text-xs">Degustacao sem login</p>
  <p class="text-white text-sm font-600">Tempo restante: <span id="demo-timer" class="text-emerald-400">--:--</span></p>
</div>

<div id="login-lock-modal" class="hidden fixed inset-0 z-50 bg-black/75 p-4 items-center justify-center">
  <div class="card rounded-2xl p-6 max-w-sm w-full text-center">
    <div class="w-12 h-12 rounded-xl bg-emerald-500 mx-auto flex items-center justify-center font-bold text-white mb-4">VC</div>
    <h2 class="brand text-xl font-700 text-white mb-2">Seu teste livre terminou</h2>
    <p class="text-slate-400 text-sm mb-5">
      Crie sua conta para liberar 7 dias gratis. Depois disso, o plano premium custa R$ 30,00 por mes.
    </p>
    <a href="/login" class="btn-primary block rounded-xl py-3 text-white font-600">Criar conta ou entrar</a>
  </div>
</div>
{% endif %}

<!-- NAVBAR MOBILE -->
<nav class="lg:hidden sticky top-0 z-50 flex items-center justify-between px-4 py-3"
     style="background:rgba(15,23,42,0.95);border-bottom:1px solid rgba(255,255,255,0.07);backdrop-filter:blur(12px)">
  <div class="flex items-center gap-2">
    <div class="w-8 h-8 rounded-lg bg-emerald-500 flex items-center justify-center">💬</div>
    <span class="brand font-700 text-white text-lg">VoltaCliente <span class="text-emerald-400">Conchal</span></span>
  </div>
  <a href="/logout" class="text-slate-500 hover:text-red-400 text-xs transition-colors">Sair</a>
</nav>

<div class="flex min-h-screen">

  <!-- SIDEBAR DESKTOP -->
  <aside class="hidden lg:flex flex-col w-60 min-h-screen fixed top-0 left-0 p-5"
         style="background:rgba(255,255,255,0.03);border-right:1px solid rgba(255,255,255,0.06)">
    <div class="flex items-center gap-3 mb-8 pt-2">
      <div class="w-9 h-9 rounded-xl bg-emerald-500 flex items-center justify-center text-lg">💬</div>
      <span class="brand font-700 text-white text-lg leading-tight">VoltaCliente<br><span class="text-emerald-400 text-sm">Conchal</span></span>
    </div>
    <nav class="space-y-1">
      <a href="#cadastro" class="nav-link active flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-500">➕ Novo Agendamento</a>
      <a href="#gerador"  class="nav-link flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-500">🔗 Gerar Link WhatsApp</a>
      <a href="#lista"    class="nav-link flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-500">📋 Fila de Envios</a>
    </nav>
    <div class="mt-auto pt-6 border-t border-white/5">
      <div class="px-3 py-2 mb-2">
        <p class="text-slate-300 text-sm font-500">{{ session.usuario_nome }}</p>
        <p class="text-slate-500 text-xs">{{ nome_comercio }}</p>
      </div>
      <a href="/logout" class="nav-link flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-500">🚪 Sair</a>
    </div>
  </aside>

  <!-- CONTEÚDO PRINCIPAL -->
  <main class="flex-1 lg:ml-60 p-4 lg:p-8 max-w-5xl mx-auto w-full">

    {% for msg in get_flashed_messages(category_filter=["sucesso"]) %}
    <div class="flash-sucesso rounded-xl px-4 py-3 mb-5 flex items-center gap-2 text-sm">✅ {{ msg }}</div>
    {% endfor %}
    {% for msg in get_flashed_messages(category_filter=["erro"]) %}
    <div class="flash-erro rounded-xl px-4 py-3 mb-5 flex items-center gap-2 text-sm">⚠️ {{ msg }}</div>
    {% endfor %}

    {% if is_demo %}
    <div class="card-highlight rounded-2xl p-4 mb-6">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
        <div>
          <p class="text-emerald-300 text-sm font-600">Voce esta usando a degustacao de 10 minutos.</p>
          <p class="text-slate-400 text-sm">Ao terminar, crie sua conta e ganhe 7 dias gratis.</p>
        </div>
        <a href="/login" class="btn-primary px-4 py-2 rounded-xl text-white text-sm font-600 text-center">Criar conta</a>
      </div>
    </div>
    {% elif plan_status == "trial" %}
    <div class="card-highlight rounded-2xl p-4 mb-6">
      <p class="text-emerald-300 text-sm font-600">Trial ativo: {{ trial_days_remaining }} dia(s) restante(s).</p>
      <p class="text-slate-400 text-sm">Depois do periodo gratis, o acesso continua no plano premium de R$ 30,00/mes.</p>
    </div>
    {% endif %}

    <!-- STATS -->
    <div class="grid grid-cols-3 gap-3 mb-8">
      <div class="card rounded-2xl p-4 text-center">
        <div class="stat-num text-2xl text-white">{{ agendamentos|length }}</div>
        <div class="text-slate-500 text-xs mt-1">Total</div>
      </div>
      <div class="card-highlight rounded-2xl p-4 text-center">
        <div class="stat-num text-2xl text-yellow-400">{{ agendamentos|selectattr("status","eq","pendente")|list|length }}</div>
        <div class="text-slate-500 text-xs mt-1">Pendentes</div>
      </div>
      <div class="card rounded-2xl p-4 text-center">
        <div class="stat-num text-2xl text-emerald-400">{{ agendamentos|selectattr("status","eq","enviado")|list|length }}</div>
        <div class="text-slate-500 text-xs mt-1">Enviados</div>
      </div>
    </div>

    <!-- ══ FORMULÁRIO DE CADASTRO ══ -->
    <section id="cadastro" class="card rounded-2xl p-5 lg:p-7 mb-6">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-9 h-9 rounded-xl bg-emerald-500/20 flex items-center justify-center">➕</div>
        <div>
          <h2 class="brand font-700 text-white text-lg leading-tight">Novo Agendamento</h2>
          <p class="text-slate-500 text-xs">Cadastre o cliente e agende o lembrete de retorno</p>
        </div>
      </div>

      <form method="POST" action="/dashboard">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

          <div>
            <label class="block text-slate-400 text-xs uppercase tracking-wider font-600 mb-2">Nome do Cliente *</label>
            <input type="text" name="nome" id="form-nome" placeholder="Ex: João Silva"
              class="input-field w-full rounded-xl px-4 py-3 text-sm" required
              oninput="atualizarMensagem()"/>
          </div>

          <div>
            <label class="block text-slate-400 text-xs uppercase tracking-wider font-600 mb-2">Celular (com DDD) *</label>
            <input type="tel" name="celular" placeholder="Ex: 19 99999-0000"
              class="input-field w-full rounded-xl px-4 py-3 text-sm" required
              oninput="formatarCelular(this)" maxlength="16"/>
          </div>

          <div>
            <label class="block text-slate-400 text-xs uppercase tracking-wider font-600 mb-2">Tipo de Serviço *</label>
            <select name="servico" class="input-field w-full rounded-xl px-4 py-3 text-sm" required onchange="atualizarMensagem()">
              <option value="">Selecione...</option>
              <option value="Corte de Cabelo">✂️ Corte de Cabelo</option>
              <option value="Barba">🪒 Barba</option>
              <option value="Corte + Barba">✂️🪒 Corte + Barba</option>
              <option value="Coloração">🎨 Coloração</option>
              <option value="Escova">💆 Escova</option>
              <option value="Banho e Tosa">🐾 Banho e Tosa</option>
              <option value="Unhas">💅 Unhas</option>
              <option value="Sobrancelha">👁️ Sobrancelha</option>
              <option value="Manicure/Pedicure">💅 Manicure/Pedicure</option>
              <option value="Hidratação">✨ Hidratação</option>
            </select>
          </div>

          <div>
            <label class="block text-slate-400 text-xs uppercase tracking-wider font-600 mb-2">Data do Serviço *</label>
            <input type="date" name="data_servico" id="data_servico"
              class="input-field w-full rounded-xl px-4 py-3 text-sm" required/>
          </div>

          <div class="md:col-span-2">
            <label class="block text-slate-400 text-xs uppercase tracking-wider font-600 mb-2">Intervalo para Retorno *</label>
            <div class="grid grid-cols-4 gap-3">
              {% for dias, label in [(7,"7 dias"),(15,"15 dias"),(30,"30 dias"),(45,"45 dias")] %}
              <label class="cursor-pointer">
                <input type="radio" name="intervalo" value="{{ dias }}" class="sr-only peer"
                  {{ "checked" if dias == 30 else "" }} onchange="atualizarMensagem()"/>
                <div class="peer-checked:border-emerald-500 peer-checked:bg-emerald-500/10 peer-checked:text-emerald-400
                            border border-white/10 rounded-xl py-3 text-center text-sm font-600 text-slate-400
                            hover:border-white/20 transition-all">
                  🕒 {{ label }}
                </div>
              </label>
              {% endfor %}
            </div>
          </div>

          <div class="md:col-span-2">
            <div class="flex items-center justify-between mb-2">
              <label class="text-slate-400 text-xs uppercase tracking-wider font-600">Mensagem Personalizada *</label>
              <span class="text-slate-600 text-xs" id="char-count">0 chars</span>
            </div>
            <textarea name="mensagem" id="mensagem" rows="4"
              class="input-field w-full rounded-xl px-4 py-3 text-sm resize-none leading-relaxed"
              oninput="contarChars(this)" required>{{ mensagem_padrao }}</textarea>
            <p class="text-slate-600 text-xs mt-2">
              Variáveis: <code class="text-emerald-500">{Nome}</code>
              <code class="text-emerald-500 ml-1">{Dias}</code>
              <code class="text-emerald-500 ml-1">{Servico}</code>
            </p>
          </div>
        </div>

        <div class="flex justify-end mt-6 pt-5 border-t border-white/5">
          <button type="submit" class="btn-primary px-6 py-3 rounded-xl text-white font-600 text-sm flex items-center gap-2">
            📅 Agendar Lembrete
          </button>
        </div>
      </form>
    </section>

    <!-- ══ GERADOR DE LINK WHATSAPP ══ -->
    <section id="gerador" class="card rounded-2xl p-5 lg:p-7 mb-6">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-9 h-9 rounded-xl bg-green-500/20 flex items-center justify-center">🔗</div>
        <div>
          <h2 class="brand font-700 text-white text-lg leading-tight">Gerar Link WhatsApp</h2>
          <p class="text-slate-500 text-xs">Crie um link direto para enviar mensagem a qualquer cliente</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-slate-400 text-xs uppercase tracking-wider font-600 mb-2">Celular do Cliente (com DDD)</label>
          <input type="tel" id="wpp-celular" placeholder="Ex: 19 99999-0000"
            class="input-field w-full rounded-xl px-4 py-3 text-sm"
            oninput="formatarCelular(this); gerarLink()" maxlength="16"/>
        </div>
        <div>
          <label class="block text-slate-400 text-xs uppercase tracking-wider font-600 mb-2">Nome do Cliente</label>
          <input type="text" id="wpp-nome" placeholder="Ex: João"
            class="input-field w-full rounded-xl px-4 py-3 text-sm"
            oninput="gerarLink()"/>
        </div>
        <div class="md:col-span-2">
          <label class="block text-slate-400 text-xs uppercase tracking-wider font-600 mb-2">Mensagem</label>
          <textarea id="wpp-mensagem" rows="3"
            class="input-field w-full rounded-xl px-4 py-3 text-sm resize-none"
            oninput="gerarLink()">Olá {Nome}! Tudo bem? Passando para te lembrar que já faz um tempinho que você não nos visita. Que tal agendar um horário? 😊</textarea>
        </div>
      </div>

      <!-- Link gerado -->
      <div id="wpp-resultado" class="mt-4 hidden">
        <label class="block text-slate-400 text-xs uppercase tracking-wider font-600 mb-2">Link Gerado</label>
        <div class="wpp-link-box rounded-xl p-4 flex items-center gap-3">
          <input type="text" id="wpp-link-texto" readonly
            class="bg-transparent text-emerald-400 text-xs flex-1 outline-none truncate"/>
          <button onclick="copiarLink()"
            class="text-slate-400 hover:text-white text-xs border border-white/10 hover:border-white/30 px-3 py-1.5 rounded-lg transition-all flex-shrink-0"
            id="btn-copiar">📋 Copiar</button>
        </div>
        <a id="wpp-abrir" href="#" target="_blank"
           class="btn-wpp mt-3 w-full py-3 rounded-xl text-white font-600 text-sm flex items-center justify-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Abrir no WhatsApp
        </a>
      </div>
    </section>

    <!-- ══ FILA DE ENVIOS ══ -->
    <section id="link-profissional" class="card rounded-2xl p-5 lg:p-7 mb-6">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-9 h-9 rounded-xl bg-emerald-500/20 flex items-center justify-center">IG</div>
        <div>
          <h2 class="brand font-700 text-white text-lg leading-tight">Link profissional para Instagram</h2>
          <p class="text-slate-500 text-xs">Leve a cliente do Instagram para o WhatsApp e para sua agenda.</p>
        </div>
      </div>

      <form method="POST" action="/configuracao/whatsapp" class="grid md:grid-cols-[1fr_auto] gap-3 mb-4">
        <input name="whatsapp_profissional" value="{{ whatsapp_profissional or '' }}"
               placeholder="WhatsApp profissional com DDD"
               class="input-field w-full rounded-xl px-4 py-3 text-sm">
        <button class="btn-primary px-5 py-3 rounded-xl text-white font-600 text-sm">Salvar WhatsApp</button>
      </form>

      <div class="space-y-3">
        <div class="wpp-link-box rounded-xl p-4">
          <label class="block text-slate-400 text-xs uppercase tracking-wider font-600 mb-2">Link da agenda publica</label>
          <input readonly value="{{ public_agenda_url }}"
                 class="bg-transparent text-emerald-400 text-xs w-full outline-none truncate">
        </div>
        <div class="wpp-link-box rounded-xl p-4">
          <label class="block text-slate-400 text-xs uppercase tracking-wider font-600 mb-2">Mensagem pronta para WhatsApp</label>
          <textarea readonly rows="3" class="bg-transparent text-emerald-400 text-xs w-full outline-none resize-none">{{ msg_instagram }}</textarea>
        </div>
        {% if whatsapp_link_profissional %}
        <a href="{{ whatsapp_link_profissional }}" target="_blank"
           class="btn-wpp w-full py-3 rounded-xl text-white font-600 text-sm flex items-center justify-center">
          Abrir link profissional no WhatsApp
        </a>
        {% endif %}
      </div>
    </section>

    <section id="lista">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-slate-700/50 flex items-center justify-center">📋</div>
          <div>
            <h2 class="brand font-700 text-white text-lg leading-tight">Fila de Envios</h2>
            <p class="text-slate-500 text-xs">{{ agendamentos|length }} agendamento(s)</p>
          </div>
        </div>
        <select id="filtro-status" onchange="filtrarTabela()"
          class="input-field rounded-xl px-3 py-2 text-xs">
          <option value="todos">Todos</option>
          <option value="pendente">Pendentes</option>
          <option value="enviado">Enviados</option>
        </select>
      </div>

      {% if agendamentos %}
      <!-- Tabela desktop -->
      <div class="card rounded-2xl overflow-hidden hidden md:block">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-white/5">
              <th class="text-left px-5 py-4 text-slate-500 text-xs uppercase tracking-wider font-600">Cliente</th>
              <th class="text-left px-5 py-4 text-slate-500 text-xs uppercase tracking-wider font-600">Serviço</th>
              <th class="text-left px-5 py-4 text-slate-500 text-xs uppercase tracking-wider font-600">Envio em</th>
              <th class="text-center px-5 py-4 text-slate-500 text-xs uppercase tracking-wider font-600">Status</th>
              <th class="text-center px-5 py-4 text-slate-500 text-xs uppercase tracking-wider font-600">WhatsApp</th>
            </tr>
          </thead>
          <tbody>
            {% for ag in agendamentos %}
            {% set atrasado = ag.status == "pendente" and ag.data_envio < hoje %}
            <tr class="table-row" data-status="{{ ag.status }}">
              <td class="px-5 py-4">
                <div class="font-500 text-white">{{ ag.cliente_nome }}</div>
                <div class="text-slate-500 text-xs">{{ ag.cliente_celular }}</div>
              </td>
              <td class="px-5 py-4 text-slate-300">{{ ag.tipo_servico }}</td>
              <td class="px-5 py-4 text-slate-300 text-xs">{{ ag.data_envio }}</td>
              <td class="px-5 py-4 text-center">
                {% if ag.status == "enviado" %}
                  <span class="badge-enviado text-xs px-2.5 py-1 rounded-full font-500">✅ Enviado</span>
                {% elif atrasado %}
                  <span class="badge-atrasado text-xs px-2.5 py-1 rounded-full font-500">⚠️ Atrasado</span>
                {% else %}
                  <span class="badge-pendente text-xs px-2.5 py-1 rounded-full font-500">🕒 Pendente</span>
                {% endif %}
              </td>
              <td class="px-5 py-4 text-center">
                {% set numero_limpo = ag.cliente_celular | replace(' ','') | replace('-','') | replace('(','') | replace(')','') %}
                <a href="https://wa.me/55{{ numero_limpo }}?text={{ ag.mensagem_personalizada | urlencode }}"
                   target="_blank"
                   class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-500 transition-all"
                   style="background:rgba(37,211,102,0.1);color:#25d366;border:1px solid rgba(37,211,102,0.2)">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                  Enviar
                </a>
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      <!-- Cards mobile -->
      <div class="space-y-3 md:hidden">
        {% for ag in agendamentos %}
        {% set atrasado = ag.status == "pendente" and ag.data_envio < hoje %}
        {% set numero_limpo = ag.cliente_celular | replace(' ','') | replace('-','') | replace('(','') | replace(')','') %}
        <div class="card rounded-2xl p-4" data-status="{{ ag.status }}">
          <div class="flex items-start justify-between mb-3">
            <div>
              <div class="font-600 text-white">{{ ag.cliente_nome }}</div>
              <div class="text-slate-500 text-xs">{{ ag.cliente_celular }}</div>
            </div>
            {% if ag.status == "enviado" %}
              <span class="badge-enviado text-xs px-2.5 py-1 rounded-full font-500">✅ Enviado</span>
            {% elif atrasado %}
              <span class="badge-atrasado text-xs px-2.5 py-1 rounded-full font-500">⚠️ Atrasado</span>
            {% else %}
              <span class="badge-pendente text-xs px-2.5 py-1 rounded-full font-500">🕒 Pendente</span>
            {% endif %}
          </div>
          <div class="flex items-center gap-4 text-xs text-slate-400 mb-3">
            <span>✂️ {{ ag.tipo_servico }}</span>
            <span>📅 {{ ag.data_envio }}</span>
          </div>
          <a href="https://wa.me/55{{ numero_limpo }}?text={{ ag.mensagem_personalizada | urlencode }}"
             target="_blank"
             class="btn-wpp w-full py-2.5 rounded-xl text-white font-500 text-xs flex items-center justify-center gap-2">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Abrir no WhatsApp
          </a>
        </div>
        {% endfor %}
      </div>

      {% else %}
      <div class="card rounded-2xl p-12 text-center">
        <div class="text-5xl mb-4">📭</div>
        <h3 class="brand font-700 text-white text-lg mb-2">Nenhum agendamento ainda</h3>
        <p class="text-slate-500 text-sm">Cadastre seu primeiro cliente acima!</p>
      </div>
      {% endif %}
    </section>

    <p class="text-center text-slate-700 text-xs mt-8">VoltaCliente Conchal © 2025 — Feito para pequenos comércios 💚</p>
    {% if plan_status != "active" %}
    <section class="card-highlight rounded-2xl p-5 lg:p-7 mt-6">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <h2 class="brand font-700 text-white text-lg leading-tight">Seja premium e use sem expirar</h2>
          <p class="text-slate-400 text-sm mt-1">Libere agenda, lembretes, historico e links profissionais por R$ 30,00/mes.</p>
        </div>
        <a href="{{ checkout_url }}" target="_blank" class="btn-primary px-5 py-3 rounded-xl text-white font-600 text-sm text-center">Assinar premium</a>
      </div>
    </section>
    {% endif %}

    <section id="agenda-site" class="card rounded-2xl p-5 lg:p-7 mt-6">
      <div class="flex items-center gap-3 mb-5">
        <div class="w-9 h-9 rounded-xl bg-emerald-500/20 flex items-center justify-center">OK</div>
        <div>
          <h2 class="brand font-700 text-white text-lg leading-tight">Agendamentos pelo site</h2>
          <p class="text-slate-500 text-xs">Clientes que marcaram pelo seu link publico.</p>
        </div>
      </div>
      <div class="space-y-3">
        {% for ag in agendamentos_site %}
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 rounded-xl border border-white/10 p-4">
          <div>
            <p class="text-white text-sm font-600">{{ ag.cliente_nome }} - {{ ag.servico or "Atendimento" }}</p>
            <p class="text-slate-500 text-xs">{{ ag.cliente_celular }} | {{ ag.data }} as {{ ag.hora_inicio }} | {{ ag.status }}</p>
          </div>
          {% if ag.status == "agendado" %}
          <form method="POST" action="/agendamentos-site/{{ ag.id }}/cancelar">
            <button class="text-red-300 text-xs border border-red-400/30 rounded-lg px-3 py-2">Desmarcar</button>
          </form>
          {% endif %}
        </div>
        {% else %}
        <p class="text-slate-500 text-sm">Nenhum agendamento pelo site ainda.</p>
        {% endfor %}
      </div>
    </section>

    <section id="historico" class="card rounded-2xl p-5 lg:p-7 mt-6">
      <div class="flex items-center gap-3 mb-5">
        <div class="w-9 h-9 rounded-xl bg-slate-700/50 flex items-center justify-center">H</div>
        <div>
          <h2 class="brand font-700 text-white text-lg leading-tight">Historico em tempo real</h2>
          <p class="text-slate-500 text-xs">Marcacoes, cancelamentos e movimentacoes da sua conta.</p>
        </div>
      </div>
      <div class="space-y-3">
        {% for ev in historico %}
        <div class="rounded-xl border border-white/10 p-4">
          <p class="text-white text-sm">{{ ev.descricao }}</p>
          <p class="text-slate-500 text-xs mt-1">{{ ev.criado_em }}</p>
        </div>
        {% else %}
        <p class="text-slate-500 text-sm">Sem historico por enquanto.</p>
        {% endfor %}
      </div>
    </section>
  </main>
</div>

<script>
  document.getElementById("data_servico").value = "{{ hoje }}";

  function formatarCelular(input) {
    let v = input.value.replace(/\D/g, "");
    if (v.length > 11) v = v.slice(0, 11);
    if (v.length > 6)      v = v.replace(/^(\d{2})(\d{5})(\d{0,4})/, "($1) $2-$3");
    else if (v.length > 2) v = v.replace(/^(\d{2})(\d{0,5})/, "($1) $2");
    input.value = v;
  }

  function contarChars(el) {
    document.getElementById("char-count").textContent = el.value.length + " chars";
  }
  contarChars(document.getElementById("mensagem"));

  function atualizarMensagem() {
    const nome    = document.getElementById("form-nome").value || "{Nome}";
    const servico = document.querySelector("[name=servico]")?.value || "{Servico}";
    const radio   = document.querySelector("[name=intervalo]:checked");
    const dias    = radio ? radio.value : "30";
    const msg     = document.getElementById("mensagem");
    if (msg.value.includes("{Nome}") || msg.value.includes("{Servico}") || msg.value.includes("{Dias}")) {
      msg.value = `Olá ${nome}, faz ${dias} dias que você veio fazer ${servico} aqui conosco! 😊 Que tal agendarmos o seu próximo horário? Estamos te esperando!`;
      contarChars(msg);
    }
  }

  function filtrarTabela() {
    const filtro = document.getElementById("filtro-status").value;
    document.querySelectorAll("[data-status]").forEach(el => {
      el.style.display = (filtro === "todos" || el.dataset.status === filtro) ? "" : "none";
    });
  }

  // ── Gerador de Link WhatsApp ──
  function gerarLink() {
    const celular  = document.getElementById("wpp-celular").value.replace(/\D/g, "");
    const nome     = document.getElementById("wpp-nome").value || "";
    const template = document.getElementById("wpp-mensagem").value;
    const mensagem = template.replace("{Nome}", nome || "cliente");

    const resultado = document.getElementById("wpp-resultado");
    const linkTexto = document.getElementById("wpp-link-texto");
    const linkAbrir = document.getElementById("wpp-abrir");

    if (celular.length >= 10) {
      const url = `https://wa.me/55${celular}?text=${encodeURIComponent(mensagem)}`;
      linkTexto.value = url;
      linkAbrir.href  = url;
      resultado.classList.remove("hidden");
    } else {
      resultado.classList.add("hidden");
    }
  }

  function copiarLink() {
    const texto = document.getElementById("wpp-link-texto").value;
    navigator.clipboard.writeText(texto).then(() => {
      const btn = document.getElementById("btn-copiar");
      btn.textContent = "✅ Copiado!";
      setTimeout(() => { btn.textContent = "📋 Copiar"; }, 2000);
    });
  }

  // Service Worker PWA
  if ("serviceWorker" in navigator) {
    navigator.serviceWorker.register("/static/service-worker.js").catch(() => {});
  }

  {% if is_demo %}
  let demoRestante = Number("{{ demo_seconds_remaining|default(0) }}");
  const demoTimer = document.getElementById("demo-timer");
  const lockModal = document.getElementById("login-lock-modal");

  function atualizarTimerDemo() {
    const min = String(Math.floor(demoRestante / 60)).padStart(2, "0");
    const sec = String(demoRestante % 60).padStart(2, "0");
    demoTimer.textContent = `${min}:${sec}`;

    if (demoRestante <= 0) {
      lockModal.classList.remove("hidden");
      lockModal.classList.add("flex");
      document.body.style.overflow = "hidden";
      return;
    }

    demoRestante -= 1;
  }

  atualizarTimerDemo();
  setInterval(atualizarTimerDemo, 1000);
  {% endif %}
</script>
</body>
</html>
